{
  "manifest_version": 3,
  "name": "Cool Head for Chrome",
  "short_name": "Cool Head",
  "version": "1.3.0",
  "description": "Sleeps unused tabs and temporarily turns off extensions you don't need, so Chrome holds less memory. Works alone or with Cool Head.",
  "key": "",
  "minimum_chrome_version": "123",
  "background": { "service_worker": "src/worker.js", "type": "module" },
  "action": {
    "default_title": "Cool Head for Chrome",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["tabs", "tabGroups", "storage", "nativeMessaging", "alarms", "contextMenus", "scripting", "favicon", "system.memory"],
  "optional_permissions": ["management", "bookmarks"],
  "commands": {
    "sleep-tab": { "description": "Put this tab to sleep", "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" } },
    "sleep-others": { "description": "Put the other tabs in this window to sleep" },
    "save-window": { "description": "Save this window", "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" } }
  },
  "optional_host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
  }
}
